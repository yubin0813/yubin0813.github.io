---
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props
const { title, description, pubDate } = post.data
const dateStr = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
const link = `/blog/${post.id}`
---

<article class="py-5 border-b border-border last:border-0">
  <a href={link} class="group block">
    <h2 class="mb-1 text-lg font-semibold text-text transition-colors group-hover:text-accent">
      {title}
    </h2>
    <time datetime={pubDate.toISOString()} class="text-sm text-muted">{dateStr}</time>
    <p class="mt-2 text-muted">{description}</p>
  </a>
</article>
