---
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props
const { title, description, pubDate, category } = post.data
const dateStr = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
const link = `/blog/${post.id}`
const categoryLabel = category === 'tech' ? '技术' : '随笔'
const categoryBadgeClass = category === 'tech'
  ? 'bg-accent text-white'
  : 'bg-code-bg text-muted'
---

<article class="py-5 border-b border-border last:border-0">
  <a href={link} class="group block">
    <div class="mb-1 flex items-center gap-2">
      <h2 class="text-lg font-semibold text-text transition-colors group-hover:text-accent">
        {title}
      </h2>
      <span class={`rounded px-2 py-0.5 text-xs font-medium ${categoryBadgeClass}`}>{categoryLabel}</span>
    </div>
    <time datetime={pubDate.toISOString()} class="text-sm text-muted">{dateStr}</time>
    <p class="mt-2 text-muted">{description}</p>
  </a>
</article>
